; Add these to your PHP-FPM pool (e.g. /etc/php/8.3/fpm/pool.d/www.conf)
; The app reads configuration from the process environment (getenv), not a .env file.

env[TH_BASE_URL] = https://tendari.org
env[TH_SMTP_HOST] = smtp.example.com
env[TH_SMTP_PORT] = 587
env[TH_SMTP_USER] = noreply@tendari.org
env[TH_SMTP_PASS] = change-me
env[TH_SMTP_FROM] = noreply@tendari.org
env[TH_TG_TOKEN] = 123456:telegram-bot-token
env[TH_TG_BOT_USER] = tendari_bot
env[TH_TG_WEBHOOK_SECRET] = change-me
env[TH_RW_APPNAME] = tendari
env[TED_API_KEY] = change-me
env[TH_STRIPE_SECRET_KEY] = sk_live_xxx
env[TH_STRIPE_WEBHOOK_SECRET] = whsec_xxx
env[TH_STRIPE_PRICE_STARTER_MONTHLY] = price_xxx
env[TH_STRIPE_PRICE_STARTER_YEARLY] = price_xxx
env[TH_STRIPE_PRICE_PRO_MONTHLY] = price_xxx
env[TH_STRIPE_PRICE_PRO_YEARLY] = price_xxx
env[TH_STRIPE_PRICE_BUSINESS_MONTHLY] = price_xxx
env[TH_SALES_EMAIL] = hello@tendari.org
